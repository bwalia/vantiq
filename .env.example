# Copy to .env.local for local development. All of these are optional —
# the site builds and runs with none of them set.

# Canonical origin. Used by canonical URLs, Open Graph, sitemap.xml and robots.txt.
# NEXT_PUBLIC_SITE_URL=https://vantiq.co.uk

# Sub-path the site is served from. "/vanitq" for a GitHub project page;
# leave unset for a custom domain or a server deploy.
# NEXT_PUBLIC_BASE_PATH=/vanitq

# Where the enquiry funnel posts.
#   unset  → the built-in Route Handler at /api/enquiries (server deploys only)
#   a URL  → an external form service that accepts a JSON POST
#   "-"    → no endpoint; the form opens a pre-filled email instead
# NEXT_PUBLIC_ENQUIRY_ENDPOINT=https://formspree.io/f/xxxxxxxx

# Public enquiries inbox, shown in the footer and used by the email fallback.
# NEXT_PUBLIC_CONTACT_EMAIL=hello@vantiq.co.uk

# Set by the GitHub Pages workflow; you never need this locally.
# NEXT_STATIC_EXPORT=true
